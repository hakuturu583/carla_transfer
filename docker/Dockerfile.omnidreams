# OmniDreams world model for carla_transfer on a single 24 GB GPU.
#
# Build (context = repo root):
#   carla-transfer -c configs/omnidreams_rtx3090.yaml build
#   == docker build -f docker/Dockerfile.omnidreams -t carla-transfer/omnidreams:latest .
#
# flashdreams comes from the fork branch that adds the RTX 3090 manifest
# (example_world_model_rtx3090.yaml: bf16 PyTorch path, LightVAE + LightTAE,
# torch.compile, 512x288) and the sink_size support it relies on. The server
# is carla_transfer.server.omnidreams_server, run with --offload-text-encoder
# so the ~15 GB Cosmos-Reason1 encoder is freed before the DiT is built.
#
# Needs the NVIDIA Container Toolkit and an R580+ driver (CUDA 13).
ARG BASE_IMAGE=nvidia/cuda:13.2.1-cudnn-devel-ubuntu24.04
FROM ${BASE_IMAGE}

ARG FLASHDREAMS_REPO=https://github.com/hakuturu583/flashdreams.git
ARG FLASHDREAMS_REF=claude/omnidreams-rtx3090-ahncny

ENV DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    TORCHINDUCTOR_CACHE_DIR=/root/.cache/torchinductor \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    HF_HOME=/root/.cache/huggingface

RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
        git ca-certificates curl ffmpeg gcc g++ ninja-build libnccl-dev procps \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.0 /uv /uvx /usr/local/bin/

WORKDIR /opt/flashdreams
RUN git clone --depth 1 --branch "${FLASHDREAMS_REF}" "${FLASHDREAMS_REPO}" . \
    && uv python install 3.12 \
    && uv sync --package flashdreams-omnidreams --extra interactive-drive

# This package (client + in-container server) into the same venv.
COPY pyproject.toml README.md /opt/carla_transfer/
COPY src /opt/carla_transfer/src
RUN uv pip install --python /opt/flashdreams/.venv/bin/python /opt/carla_transfer

ENV PATH="/opt/flashdreams/.venv/bin:${PATH}"
VOLUME ["/root/.cache/huggingface", "/root/.cache/torchinductor"]
EXPOSE 50051

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["carla-transfer-server", "--host", "0.0.0.0", "--port", "50051", \
     "--manifest", "example_world_model_rtx3090.yaml", "--offload-text-encoder"]
