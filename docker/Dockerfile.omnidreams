# OmniDreams gRPC WorldModelService (NVIDIA flashdreams) for carla_transfer.
#
# Build:  carla-transfer build --backend omnidreams
#         (== docker build -f docker/Dockerfile.omnidreams -t carla-transfer/omnidreams:latest docker)
#
# Runtime needs the NVIDIA Container Toolkit and an R580+ driver (CUDA 13).
# RTX 3090 (SM 8.6) stays on the PyTorch bf16 path; the native FP8 extension
# is Blackwell-only and is not built here.
ARG BASE_IMAGE=nvidia/cuda:13.2.1-cudnn-devel-ubuntu24.04
FROM ${BASE_IMAGE}

ARG FLASHDREAMS_REPO=https://github.com/NVIDIA/flashdreams.git
ARG FLASHDREAMS_REF=main

ENV DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    TORCHINDUCTOR_CACHE_DIR=/root/.cache/torchinductor \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    HF_HOME=/root/.cache/huggingface

RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
        git ca-certificates curl ffmpeg gcc g++ ninja-build libnccl-dev procps \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.0 /uv /uvx /usr/local/bin/

WORKDIR /opt/flashdreams
RUN git clone --depth 1 --branch "${FLASHDREAMS_REF}" "${FLASHDREAMS_REPO}" . \
    && uv python install 3.12 \
    && uv sync --package flashdreams-omnidreams --extra interactive-drive

ENV PATH="/opt/flashdreams/.venv/bin:${PATH}"
VOLUME ["/root/.cache/huggingface", "/root/.cache/torchinductor"]
EXPOSE 50051

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["python", "-m", "omnidreams.grpc.server", "--host", "0.0.0.0", "--port", "50051", \
     "--pipeline_config_name", "omnidreams-sv-2steps-chunk2-loc6-lightvae-lighttae", \
     "--resolution", "480p"]
